<feature
    id="org.eclipse.scout.sdk-feature"
    label="%featureName"
    version="14.0.27"
    provider-name="%providerName"
    plugin="org.eclipse.scout.sdk.s2e"
    license-feature="org.eclipse.license"
    license-feature-version="0.0.0">

  <description url="https://eclipse.dev/scout/">
    %description
  </description>

  <copyright>
    %copyright
  </copyright>

  <license url="%licenseURL">
    %license
  </license>

  <url>
    <update label="%updateSiteName" url="https://download.eclipse.org/releases/2025-12/"/>
    <discovery label="%updateSiteName" url="https://download.eclipse.org/releases/2025-12/"/>
  </url>

  <requires>
    <import feature="org.eclipse.platform" version="4.34.0" match="greaterOrEqual"/>
    <import feature="org.eclipse.jdt" version="3.20.0" match="greaterOrEqual"/>
    <import feature="org.eclipse.m2e.feature" version="2.7.0" match="greaterOrEqual"/>
    <import plugin="javax.wsdl" version="1.6.2" match="greaterOrEqual"/> <!-- Is included in the p2 update site via category.xml -->
  </requires>

  <plugin
      id="org.eclipse.scout.sdk.s2e"
      download-size="0"
      install-size="0"
      version="0.0.0"/>

   <plugin
         id="org.eclipse.scout.sdk.s2e.ui"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

</feature>
