<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.scout.sdk</groupId>
    <artifactId>org.eclipse.scout.sdk</artifactId>
    <version>14.0.31</version>
    <relativePath>../org.eclipse.scout.sdk</relativePath>
  </parent>

  <artifactId>org.eclipse.scout.sdk.core.s.test</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.scout.sdk</groupId>
      <artifactId>org.eclipse.scout.sdk.core.s</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.scout.sdk</groupId>
      <artifactId>org.eclipse.scout.sdk.core.java.test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.scout.sdk</groupId>
      <artifactId>org.eclipse.scout.sdk.core.typescript.test</artifactId>
    </dependency>

    <!-- For embedded Maven execution -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-embedder</artifactId>
      <exclusions>
        <!-- use jakarta modules -->
        <exclusion>
          <groupId>javax.annotation</groupId>
          <artifactId>javax.annotation-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>javax.inject</groupId>
          <artifactId>javax.inject</artifactId>
        </exclusion>
        <exclusion>
          <groupId>javax.annotation</groupId>
          <artifactId>jsr250-api</artifactId>
        </exclusion>

        <!-- classes are part of org.codehaus.plexus:plexus-utils too -->
        <exclusion>
          <groupId>org.codehaus.plexus</groupId>
          <artifactId>plexus-xml</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-compat</artifactId>
      <exclusions>
        <!-- use jakarta modules -->
        <exclusion>
          <groupId>javax.inject</groupId>
          <artifactId>javax.inject</artifactId>
        </exclusion>

        <!-- classes are part of org.codehaus.plexus:plexus-utils too -->
        <exclusion>
          <groupId>org.codehaus.plexus</groupId>
          <artifactId>plexus-xml</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-slf4j-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.wagon</groupId>
      <artifactId>wagon-file</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.wagon</groupId>
      <artifactId>wagon-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-transport-file</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-transport-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-connector-basic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-transport-wagon</artifactId>
    </dependency>
    <dependency>
      <!-- Do not upgrade to jakarta.inject:jakarta.inject-api which is already provided by the Scout RT. Maven needs the old javax package -->
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
      <version>1</version>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>

    <!-- To extract tar archives -->
    <dependency>
      <groupId>org.apache.ant</groupId>
      <artifactId>ant</artifactId>
    </dependency>

    <!-- Scout RT Dependencies to test against -->
    <dependency>
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.ui.html.test</artifactId>
      <exclusions>
        <exclusion>
          <!-- Maven already includes aopalliance:aopalliance which should be used here instead of the one from the Scout RT (comes with Jersey) -->
          <groupId>org.glassfish.hk2.external</groupId>
          <artifactId>aopalliance-repackaged</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- NLS tests need sources of org.eclipse.scout.rt.ui.html.UiTextContributor -->
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.ui.html</artifactId>
      <scope>test</scope>
      <classifier>sources</classifier>
    </dependency>
    <dependency>
      <!-- NLS tests need sources of org.eclipse.scout.rt.shared.services.common.text.ScoutTextProviderService -->
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.shared</artifactId>
      <scope>test</scope>
      <classifier>sources</classifier>
    </dependency>
    <dependency>
      <!-- NLS tests need sources of org.eclipse.scout.rt.security.ScoutSecurityTextProviderService -->
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.security</artifactId>
      <scope>test</scope>
      <classifier>sources</classifier>
    </dependency>
    <dependency>
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.server.test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.server.jaxws</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.scout.rt</groupId>
      <artifactId>org.eclipse.scout.rt.dataobject</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>add-chart-dependency-if-available</id>
      <activation>
        <property>
          <name>org.eclipse.scout.rt_version</name>
          <value>!10.0.0-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.chart.ui.html</artifactId>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>add-datamodel.client-dependency-for-22.0-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 22.0 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>22.0-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.datamodel.client</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-datamodel.client-dependency-for-23.2-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 23.2 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>23.2-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.datamodel.client</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-datamodel.client-dependency-for-24.2-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 24.2 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>24.2-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.datamodel.client</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-datamodel.client-dependency-for-25.2-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 25.2 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>25.2-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.datamodel.client</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-datamodel.client-dependency-for-default-build</id>
      <activation>
        <property>
          <!-- add dependency if the property is not defined: for the scout version currently used in the pom (26.2) -->
          <name>!org.eclipse.scout.rt_version</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.datamodel.client</artifactId>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>add-nls.source-dependency-for-23.2-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 23.2 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>23.2-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.nls</artifactId>
          <scope>test</scope>
          <classifier>sources</classifier>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-nls.source-dependency-for-24.2-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 24.2 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>24.2-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <!-- NLS tests need sources of org.eclipse.scout.rt.nls.text.ScoutTextProviderService for Scout >= 23.2 -->
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.nls</artifactId>
          <scope>test</scope>
          <classifier>sources</classifier>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-nls.source-dependency-for-25.2-build</id>
      <activation>
        <property>
          <!-- add dependency for the scout version 25.2 -->
          <name>org.eclipse.scout.rt_version</name>
          <value>25.2-SNAPSHOT</value>
        </property>
      </activation>
      <dependencies>
        <!-- NLS tests need sources of org.eclipse.scout.rt.nls.text.ScoutTextProviderService for Scout >= 23.2 -->
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.nls</artifactId>
          <scope>test</scope>
          <classifier>sources</classifier>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>add-nls.source-dependency-for-default-build</id>
      <activation>
        <property>
          <!-- add dependency if the property is not defined: for the scout version currently used in the pom (26.2) -->
          <name>!org.eclipse.scout.rt_version</name>
        </property>
      </activation>
      <dependencies>
        <!-- NLS tests need sources of org.eclipse.scout.rt.nls.text.ScoutTextProviderService for Scout >= 23.2 -->
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.nls</artifactId>
          <scope>test</scope>
          <classifier>sources</classifier>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>add-session-dependency-for-default-build</id>
      <activation>
        <property>
          <!-- add dependency for the default scout version (26.2) -->
          <name>!org.eclipse.scout.rt_version</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.server.session</artifactId>
        </dependency>
        <dependency>
          <groupId>org.eclipse.scout.rt</groupId>
          <artifactId>org.eclipse.scout.rt.server.session.test</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-test-source</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>src/test/client</source>
                <source>src/test/shared</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
